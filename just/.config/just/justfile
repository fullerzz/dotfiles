_default:
    @just -g --list

# update homebrew and then upgrade packages
brewupdg:
    @echo "\n🍺{{ BOLD + CYAN }} Updating Homebrew and upgrading packages...{{ NORMAL }}"
    brew update
    brew outdated --greedy
    brew upgrade
    brew cleanup
    @just -g brew-bundle

# generate or update existing Brewfile
brew-bundle:
    @echo "\n🍺{{ BOLD + CYAN }} Generating Brewfile...{{ NORMAL }}"
    brew bundle dump --force --file=~/Brewfile
    @echo "\n✅{{ BOLD + GREEN }}Brewfile generated!{{ NORMAL }}"
    rsync -tv --mkpath -- ~/Brewfile /Volumes/Shibi/backups/
    @echo "\n✅{{ BOLD + GREEN }}Brewfile backed up to UNAS2 Shibi/backups/Brewfile successfully!{{ NORMAL }}"

# prune docker images, containers, volumes, and networks
docker-prune:
    @echo "🧼{{ BOLD + BLUE }} Pruning docker {{ INVERT }}images{{ NORMAL }}"
    docker image prune
    @echo "🧼{{ BOLD + BLUE }} Pruning docker {{ INVERT }}containers{{ NORMAL }}"
    docker container prune
    @echo "🧼{{ BOLD + BLUE }} Pruning docker {{ INVERT }}networks{{ NORMAL }}"
    docker network prune
    @echo "\n{{ BOLD + GREEN }}Docker images, containers, networks pruned successfully!{{ NORMAL }}"
    @echo "🐳{{ CYAN }} More info: https://docs.docker.com/engine/manage-resources/pruning/ {{ NORMAL }}"

# create bare git repo in the current directory and setup remote tracking
git-clone-bare GIT_URL:
    @echo "{{ BOLD + CYAN }}Cloning {{ GIT_URL }}{{ NORMAL }}"
    git clone --bare {{GIT_URL}} .bare
    echo "gitdir: ./.bare" > .git
    git config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
    @echo "\n{{ BOLD + GREEN }}Bare git repo set up successfully!{{ NORMAL }}"

# update uv tools
uvx-up:
    @echo "\n⚡️{{ BOLD + MAGENTA }} Updating uv tools...{{ NORMAL }}"
    uv tool upgrade --all

# update bun and pnpm-managed global packages (excluding hunkdiff's bun dependency path)
npm-up:
    @echo "\n🤮{{ BOLD + YELLOW }} Updating bun and pnpm global packages...{{ NORMAL }}"
    # bun update -g
    pnpm -g update --latest

# run updates for all tools
send-it:
    @echo "🗿{{ BOLD + CYAN }} Running updates for all tools...{{ NORMAL }}"
    @just -g brewupdg
    @just -g uvx-up
    @just -g npm-up
    @echo "\n✅{{ BOLD + GREEN }} All tools updated successfully!{{ NORMAL }}"

# install specified python version using pyenv
pyenv-install PYTHON_VERSION:
    @echo "\n🐍{{ BOLD + BLUE }} Installing optimized build of Python {{ PYTHON_VERSION }}...{{ NORMAL }}"
    PYTHON_CFLAGS='-march=native -mtune=native' CONFIGURE_OPTS='--enable-optimizations --with-lto' pyenv install {{ PYTHON_VERSION }} --verbose

# start the lima agent-dev VM
[group('lima')]
agentvm-start:
    @echo "\n🚀{{ BOLD + MAGENTA }} Starting lima agent-dev VM...{{ NORMAL }}"
    limactl start --name=agent-dev ~/.lima-templates/agent-dev.yaml

# restart the lima agent-dev VM
[group('lima')]
agentvm-restart:
    @echo "\n🔄{{ BOLD + MAGENTA }} Restarting lima agent-dev VM...{{ NORMAL }}"
    limactl restart agent-dev

# stop the lima agent-dev VM
[group('lima')]
agentvm-stop:
    @echo "\n🛑{{ BOLD + MAGENTA }} Stopping lima agent-dev VM...{{ NORMAL }}"
    -limactl stop agent-dev

# delete the lima agent-dev VM
[group('lima')]
[confirm('Are you sure you want to delete the lima agent-dev VM? This action cannot be undone. (y/n)')]
agentvm-delete:
    @echo "\n❌{{ BOLD + MAGENTA }} Deleting lima agent-dev VM...{{ NORMAL }}"
    -limactl delete agent-dev

# archive the lima agent-dev VM to a baseline snapshot
[group('lima')]
agentvm-archive: agentvm-stop
    @echo "\n♻️{{ BOLD + MAGENTA }} Archiving lima agent-dev VM to baseline snapshot...{{ NORMAL }}"
    tar -C ~/.lima -czf ~/agent-dev-clean-baseline.tgz agent-dev

# restore the lima agent-dev VM baseline snapshot
[group('lima')]
[confirm('Are you sure you want to restore the lima agent-dev VM baseline snapshot? This action cannot be undone. (y/n)')]
agentvm-restore: agentvm-stop agentvm-delete
    @echo "\n♻️{{ BOLD + MAGENTA }} Restoring lima agent-dev VM baseline snapshot...{{ NORMAL }}"
    tar -C ~/.lima -xzf ~/agent-dev-clean-baseline.tgz
    limactl start agent-dev
