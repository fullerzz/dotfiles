{
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",
  "model": "anthropic/claude-sonnet-4-20250514",
  "small_model": "openai/gpt-5-nano",
  "autoshare": false,
  "autoupdate": true,
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {},
        "qwen3-coder:30b": {},
        "qwen3:30b-a3b": {},
        "qwen3:4b": {},
        "gpt-oss:20b": {}
      }
    },
    "openrouter": {
      "models": {
        "qwen/qwen3-coder": {},
        "moonshotai/kimi-k2": {},
        "openai/gpt-5": {},
        "openai/gpt-5-mini": {},
        "openai/gpt-5-nano": {},
        "anthropic/claude-opus-4.1": {}
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "openai/gpt-oss-20b": {
          "name": "gpt-oss-20b (local)"
        }
      }
    }
  },
  "mcp": {
    "github-mcp": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_MCP_TOKEN}"
      }
    },
    "context7": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true
    }
  }
}
